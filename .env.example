# Copy to .env and change every password. .env is gitignored.
# --- MQTT (docs/04 §5.1) ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=pdm/v1
MQTT_SITE_ID=lab
MQTT_BACKEND_PASSWORD=change-me-backend
MQTT_REPLAY_PASSWORD=change-me-replay
MQTT_HARNESS_PASSWORD=change-me-harness
# ESP32: its MQTT username is its asset id (ACL pattern %u)
ESP32_ASSET_ID=FD001-E001
MQTT_DEVICE_PASSWORD=change-me-device

# --- HTTP ingest fallback ---
INGEST_URL=http://localhost:8000/api/v1/ingest
INGEST_API_KEY=replace-with-32-plus-random-characters-xxxxxxxx

# --- Database ---
POSTGRES_USER=pdm
POSTGRES_PASSWORD=change-me-db
POSTGRES_DB=pdm
DATABASE_URL=postgresql+psycopg://pdm:change-me-db@localhost:5432/pdm

# --- ML ---
MODEL_ROOT=ml/artifacts
ACTIVE_PROFILES=FD001,FD002,FD003,FD004
DATA_RAW_DIR=data/raw/cmapss
